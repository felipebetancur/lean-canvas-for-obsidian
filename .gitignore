# Excluir configuraciones de espacio de trabajo y caché de Obsidian
.obsidian/workspace
.obsidian/workspace.json
.obsidian/graph.json
.obsidian/cache/

# PROTEGER PRIVACIDAD: Excluir configuraciones y credenciales de plugins
.obsidian/plugins/**/data.json
.obsidian/plugins/**/data.json.bak

# PERMITIR SNIPPETS Y COMPLEMENTOS: Asegurar que las carpetas base se compartan
!.obsidian/snippets/
!.obsidian/plugins/

# Excluir archivos ocultos del sistema operativo
.DS_Store
Thumbs.db
